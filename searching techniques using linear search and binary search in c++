#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int numbers[100], n, target, choice;

    cout << "How many numbers? ";
    cin >> n;

    cout << "Enter the numbers: ";
    for (int i = 0; i < n; i++)
        cin >> numbers[i];

    cout << "Search for: ";
    cin >> target;

    cout << "1. Linear Search\n2. Binary Search\nChoose: ";
    cin >> choice;

    if (choice == 2)
        sort(numbers, numbers + n);

    int position = -1;

    if (choice == 1) {
        for (int i = 0; i < n; i++)
            if (numbers[i] == target) {
                position = i;
                break;
            }
    } else if (choice == 2) {
        int left = 0, right = n - 1;
        while (left <= right) {
            int mid = left + (right - left) / 2;
            if (numbers[mid] == target) {
                position = mid;
                break;
            } else if (numbers[mid] < target)
                left = mid + 1;
            else
                right = mid - 1;
        }
    } else {
        cout << "Invalid choice.\n";
        return 0;
    }

    if (position == -1)
        cout << "Number not found.\n";
    else
        cout << "Number found at index " << position << ".\n";

    return 0;
}
